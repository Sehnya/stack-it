generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int        @id @default(autoincrement())
  username               String     @unique
  email                  String     @unique
  password               String
  role                   String     @default("user")
  profilePhoto           String?    @map("profile_photo")
  bio                    String?
  emailVerified          Boolean    @default(false) @map("email_verified")
  verificationCode       String?    @map("verification_code")
  verificationExpires    DateTime?  @map("verification_expires")
  lastSeen               DateTime?  @map("last_seen")
  dismissedWelcomeBanner Boolean    @default(false) @map("dismissed_welcome_banner")
  createdAt              DateTime   @default(now()) @map("created_at")
  
  posts             Post[]
  favorites         Favorite[]
  likes             Like[]
  comments          Comment[]
  followers         Follow[]           @relation("following")
  following         Follow[]           @relation("followers")
  threads           ForumThread[]
  snippets          Snippet[]
  snippetRatings    SnippetRating[]
  snippetFavorites  SnippetFavorite[]

  @@map("users")
}

model Post {
  id           Int        @id @default(autoincrement())
  title        String
  excerpt      String
  content      String
  coverImage   String?    @map("cover_image")
  technologies String     // JSON array stored as string
  viewCount    Int        @default(0) @map("view_count")
  authorId     Int        @map("author_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  favorites Favorite[]
  likes     Like[]
  files     PostFile[]
  comments  Comment[]
  views     PostView[]

  @@map("posts")
}

model PostView {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  postId    Int      @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("post_views")
}

model PostFile {
  id       Int    @id @default(autoincrement())
  postId   Int    @map("post_id")
  name     String
  language String
  code     String
  
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_files")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  postId    Int      @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("favorites")
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  postId    Int      @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("likes")
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  userId    Int      @map("user_id")
  postId    Int      @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int      @map("follower_id")
  followingId Int      @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")
  
  follower  User @relation("followers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Stack {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  difficulty  String
  rating      Float    @default(0.0)
  usageCount  Int      @default(0) @map("usage_count")
  technologies String
  codeSnippet String   @map("code_snippet")
  createdAt   DateTime @map("created_at")

  @@map("stacks")
}

model PinnedTech {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  techName   String   @map("tech_name")
  lastReadAt DateTime @default(now()) @map("last_read_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, techName])
  @@map("pinned_techs")
}

model ForumThread {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  category   String   @default("general") // general, help, showcase, feedback
  tags       String   // JSON array stored as string
  authorId   Int      @map("author_id")
  postId     Int?     @map("post_id") // optional link to a stack post
  resolved   Boolean  @default(false)
  pinned     Boolean  @default(false)
  viewCount  Int      @default(0) @map("view_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies ForumReply[]

  @@map("forum_threads")
}

model ForumReply {
  id        Int      @id @default(autoincrement())
  content   String
  threadId  Int      @map("thread_id")
  authorId  Int      @map("author_id")
  isAnswer  Boolean  @default(false) @map("is_answer")
  likes     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@map("forum_replies")
}

model Snippet {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  code        String
  language    String
  tags        String   // JSON array stored as string
  authorId    Int      @map("author_id")
  viewCount   Int      @default(0) @map("view_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  author          User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ratings         SnippetRating[]
  favorites       SnippetFavorite[]

  @@map("snippets")
}

model SnippetRating {
  id        Int      @id @default(autoincrement())
  snippetId Int      @map("snippet_id")
  userId    Int      @map("user_id")
  rating    Int      // 1-5 stars
  createdAt DateTime @default(now()) @map("created_at")

  snippet Snippet @relation(fields: [snippetId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([snippetId, userId])
  @@map("snippet_ratings")
}

model SnippetFavorite {
  id        Int      @id @default(autoincrement())
  snippetId Int      @map("snippet_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  snippet Snippet @relation(fields: [snippetId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([snippetId, userId])
  @@map("snippet_favorites")
}
