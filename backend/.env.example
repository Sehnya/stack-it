# Server (Railway sets PORT automatically)
PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://stack-it.dev

# JWT (generate a secure random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Turso Database (get from turso.tech)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# For local development, leave TURSO vars empty to use SQLite
