{
  "name": "stack-it-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "db:generate": "bunx prisma generate",
    "db:push": "bunx prisma db push",
    "db:studio": "bunx prisma studio",
    "db:seed": "bun run src/seed.ts",
    "db:reset": "rm -f prisma/dev.db && bunx prisma db push --force-reset && bunx prisma generate && bun run src/seed.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.0",
    "@elysiajs/html": "^1.4.0",
    "@elysiajs/jwt": "^1.1.0",
    "@elysiajs/static": "^1.1.0",
    "@libsql/client": "0.5.6",
    "@prisma/adapter-libsql": "^5.17.0",
    "@prisma/client": "^5.17.0",
    "@sinclair/typebox": "^0.34.41",
    "elysia": "^1.1.0"
  },
  "devDependencies": {
    "bun-types": "^1.1.18",
    "prisma": "^5.17.0",
    "typescript": "^5.5.3"
  }
}
